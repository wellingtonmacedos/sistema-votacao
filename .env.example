# Copie este arquivo para .env e preencha os valores.

# Banco de dados (Prisma/PostgreSQL).
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_votacao?schema=public"

# Porta do Postgres publicada pelo docker-compose (apenas em 127.0.0.1, para
# administracao/dev local; o app acessa pela rede interna do Docker).
POSTGRES_PORT=5432

# NextAuth: obrigatorio. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Rate limit (opcional). Backend Redis para o limite de tentativas de login,
# compartilhado entre reinicios/instancias. Se vazio, usa o fallback em memoria
# (nao escala horizontalmente, mas funciona em dev/CI).
# No docker-compose o padrao ja aponta para o servico "redis".
REDIS_URL=

# URL publica da aplicacao. Em desenvolvimento: http://localhost:3000.
# Em producao use a URL com https e o mesmo dominio que o Nginx expoe
# (ex.: https://votacao.suacidade.gov.br) -- os cookies de sessao dependem dela.
NEXTAUTH_URL=http://localhost:3000

# Upload de arquivos em S3 (opcional; sem isso o upload usa o disco local)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# Backup do banco (obrigatorio para o servico "backup" do docker-compose).
# Gere uma chave de 32 bytes com: openssl rand -base64 32
# GUARDE esta chave: sem ela os backups nao podem ser restaurados.
BACKUP_ENCRYPTION_KEY=

# Politica de backup (opcional; valores padrao abaixo)
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24
