# Copie este arquivo para .env e preencha os valores.

# Banco de dados (Prisma/PostgreSQL).
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_votacao?schema=public"

# NextAuth: obrigatorio. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL publica da aplicacao (ex.: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Upload de arquivos em S3 (opcional; sem isso o upload usa o disco local)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
